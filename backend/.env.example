# Kredensial Shopee Open Platform — JANGAN di-commit.
# Di server, file ini ditaruh di data dir (default /var/lib/mp-backend/.env)
# dengan permission 600, milik user service.
SHOPEE_PARTNER_ID_LIVE=
SHOPEE_PARTNER_KEY_LIVE=

# Opsional (app test Shopee)
SHOPEE_PARTNER_ID_TEST=
SHOPEE_PARTNER_KEY_TEST=

# --- Runtime (semua opsional, ini nilai default) ---
# HOST=127.0.0.1        # loopback karena selalu di belakang nginx
# PORT=5010
# MP_DATA_DIR=/var/lib/mp-backend   # tempat token.json, cache, export_summary.json
# MP_ENV_FILE=<MP_DATA_DIR>/.env
# MP_TOKEN_FILE=<MP_DATA_DIR>/token.json
# MP_ALLOW_ORIGIN=      # kosong = tanpa header CORS (deploy same-origin).
                        # Isi origin spesifik kalau frontend beda host,
                        # contoh: https://mpqukis.web.id
